// ShabooAgri Phase 1 schema — approved proposal, 2026-08-07.
// Every tenant-scoped model carries companyId so Phase 2 multi-tenant admin
// requires no schema rework (see docs/ShabooAgri_Goal_Specification.md §2/§9/§10).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums (fixed workflow/system states — not business-configurable terminology) ----------

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
}

enum AvailabilityStatus {
  AVAILABLE
  ON_JOB
  OFF_DUTY
}

enum FuelType {
  DIESEL
  PETROL
  ELECTRIC
  OTHER
}

enum MachineStatus {
  WORKING
  AVAILABLE
  REPAIR
  OFFLINE
}

enum BookingStatus {
  PENDING
  ACCEPTED
  ON_THE_WAY
  WORKING
  COMPLETED
  CANCELLED
}

enum JobStatus {
  NOT_STARTED
  WORKING
  PAUSED
  COMPLETED
  CANCELLED
}

enum JobExecutionMode {
  LIVE
  MANUAL
}

enum CompensationType {
  HOURLY
  MONTHLY
  YEARLY
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  VOIDED
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CREDIT
}

enum OtpPurpose {
  LOGIN
  VERIFY
  RESET
}

// ---------- Tenancy, terminology (§9), white-label (§10) ----------

model Company {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  slug              String  @unique
  logoUrl           String? @map("logo_url")
  themeColor        String? @default("#1B7A3E") @map("theme_color")
  accentColor       String? @map("accent_color")
  currency          String  @default("INR")
  timezone          String  @default("Asia/Kolkata")
  language          String  @default("en")
  invoicePrefix     String? @default("INV") @map("invoice_prefix")
  printLayout       Json?   @map("print_layout")
  isActive          Boolean @default(true) @map("is_active")
  // Opaque reference to the ShabooAgri platform's PlatformUser id, set only
  // by /internal/provision-company. Deliberately a plain string, not a
  // Prisma relation — the platform database is a separate database
  // entirely, so there is nothing here for a relation to point to. This
  // field exists purely so the internal endpoint can recognize "has this
  // platform user already been provisioned" without a second DB round trip
  // through the platform side.
  platformUserId    String? @unique @map("platform_user_id")
  // Cached from the platform database at provisioning/upgrade time via
  // /internal/update-plan — never read live from the platform backend on
  // any operational request path (same principle as the old license-
  // expiry gate this project already had to remove once). planKey is
  // purely informational (which tier, for display/support purposes);
  // machineLimit is what machine.service actually enforces. null on both
  // means "no plan assigned" (e.g. pilot, or any internally-managed
  // company) — unlimited, not zero.
  planKey           String? @map("plan_key")
  machineLimit      Int?    @map("machine_limit")
  // Monotonic counter backing Booking.bookingNumber (BK-000001, ...).
  // Incremented atomically ("SET x = x + 1") on every booking creation and
  // NEVER decremented or reused, even if the booking that consumed a
  // number is later hard-deleted — see bookings/README.md.
  nextBookingNumber Int     @default(1) @map("next_booking_number")
  // Monotonic counter backing Invoice.invoiceNumber (INV-000001, ...).
  // Incremented atomically on every invoice creation — see payments/README.md.
  nextInvoiceNumber Int     @default(1) @map("next_invoice_number")

  // Phase B Business Identity fields
  address         String? @map("address")
  city            String? @map("city")
  district        String? @map("district")
  state           String? @map("state")
  pincode         String? @map("pincode")
  country         String? @default("India") @map("country")
  phone           String? @map("phone")
  email           String? @map("email")
  isGstRegistered Boolean @default(false) @map("is_gst_registered")
  gstin           String? @map("gstin")
  pan             String? @map("pan")

  // Phase B Bank & Payment Details
  bankName      String? @map("bank_name")
  accountNumber String? @map("account_number")
  ifscCode      String? @map("ifsc_code")
  upiId         String? @map("upi_id")

  // Phase B Tax defaults
  defaultTaxRate Decimal? @default(0) @map("default_tax_rate") @db.Decimal(5, 2)
  taxInclusive   Boolean  @default(false) @map("tax_inclusive")
  isCessEnabled  Boolean  @default(false) @map("is_cess_enabled")

  // Phase C Equipment & Operational Rules
  serviceAlertHours  Int     @default(50) @map("service_alert_hours")
  insuranceAlertDays Int     @default(30) @map("insurance_alert_days")
  licenseAlertDays   Int     @default(30) @map("license_alert_days")
  requireJobPhoto    Boolean @default(false) @map("require_job_photo")
  requireJobFuelLog  Boolean @default(false) @map("require_job_fuel_log")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  terminologySettings  TerminologySetting[]
  roles                Role[]
  users                User[]
  customers            Customer[]
  employees            Employee[]
  drivers              Driver[]
  villages             Village[]
  machineTypes         MachineType[]
  machines             Machine[]
  pricingMethods       PricingMethod[]
  bookings             Booking[]
  bookingAttachments   BookingAttachment[]
  jobs                 Job[]
  jobStatusLogs        JobStatusLog[]
  jobPhotos            JobPhoto[]
  jobFuelEntries       JobFuelEntry[]
  maintenanceSchedules MaintenanceSchedule[]
  maintenanceRecords   MaintenanceRecord[]
  expenseCategories    ExpenseCategory[]
  expenses             Expense[]
  invoices             Invoice[]
  payments             Payment[]
  customerAdvances     CustomerAdvance[]
  auditLogs            AuditLog[]
  gstCessRules         GstCessRule[]
  staffInvites         StaffInvite[]

  @@map("companies")
}

model TerminologySetting {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId            String   @map("company_id") @db.Uuid
  termKey              String   @map("term_key") // 'customer' | 'driver' | 'machine' | 'booking' | 'invoice'
  displayLabelSingular String   @map("display_label_singular")
  displayLabelPlural   String   @map("display_label_plural")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, termKey])
  @@map("terminology_settings")
}

// ---------- RBAC (§6) — enforced from stored data in Phase 1, no admin UI yet ----------

model Role {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  systemKey    String?  @map("system_key") // 'owner' | 'manager' | 'driver' | 'farmer' | null for custom roles
  name         String
  isSystemRole Boolean  @default(true) @map("is_system_role")
  createdAt    DateTime @default(now()) @map("created_at")

  company         Company          @relation(fields: [companyId], references: [id])
  users           User[]
  rolePermissions RolePermission[]
  staffInvites    StaffInvite[]

  @@unique([companyId, name])
  @@map("roles")
}

model Permission {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String @unique // e.g. 'booking.create', 'payment.receive'
  description String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ---------- Users, Customers, Employees, Drivers ----------

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String     @map("company_id") @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  fullName     String     @map("full_name")
  email        String?
  mobileNumber String?    @map("mobile_number")
  passwordHash String?    @map("password_hash")
  pinHash      String?    @map("pin_hash")
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])
  role    Role    @relation(fields: [roleId], references: [id])

  customerProfile Customer?
  employeeProfile Employee?
  refreshTokens   RefreshToken[]
  launchTokens    LaunchToken[]
  auditLogs       AuditLog[]

  managedBookings     Booking[]           @relation("BookingManager")
  createdBookings     Booking[]           @relation("BookingCreatedBy")
  uploadedAttachments BookingAttachment[]
  jobStatusChanges    JobStatusLog[]
  uploadedJobPhotos   JobPhoto[]
  recordedFuelEntries JobFuelEntry[]
  recordedExpenses    Expense[]
  receivedPayments    Payment[]         @relation("PaymentReceivedBy")
  voidedPayments      Payment[]         @relation("PaymentVoidedBy")
  voidedInvoices      Invoice[]
  receivedAdvances    CustomerAdvance[]
  invitesSent         StaffInvite[]

  @@unique([companyId, email])
  @@unique([companyId, mobileNumber])
  @@map("users")
}

model Customer {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  userId          String?  @unique @map("user_id") @db.Uuid
  name            String
  villageId       String   @map("village_id") @db.Uuid
  phone           String?
  address         String?
  notes           String?
  // Phase B Customer GST fields (Optional)
  isGstApplicable Boolean  @default(false) @map("is_gst_applicable")
  gstin           String?  @map("gstin")
  // Manager-facing "remove" action — a Customer with any Booking history
  // can never be hard-deleted (see dependencyGuard), so this is the
  // non-Owner alternative: mark inactive without losing booking/invoice
  // history. Same pattern as Machine.isActive / Employee.employmentStatus.
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company  Company           @relation(fields: [companyId], references: [id])
  user     User?             @relation(fields: [userId], references: [id])
  village  Village           @relation(fields: [villageId], references: [id])
  bookings Booking[]
  invoices Invoice[]
  advances CustomerAdvance[]
  invites  StaffInvite[]

  @@map("customers")
}

model Employee {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String           @map("company_id") @db.Uuid
  userId           String?          @unique @map("user_id") @db.Uuid
  name             String
  phone            String?
  roleTitle        String?          @map("role_title")
  employmentStatus EmploymentStatus @default(ACTIVE) @map("employment_status")
  compensationType CompensationType @default(HOURLY) @map("compensation_type")
  hourlyRate       Decimal?         @map("hourly_rate") @db.Decimal(10, 2)
  monthlySalary    Decimal?         @map("monthly_salary") @db.Decimal(10, 2)
  yearlySalary     Decimal?         @map("yearly_salary") @db.Decimal(10, 2)
  joinedDate       DateTime?        @map("joined_date") @db.Date
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  company Company       @relation(fields: [companyId], references: [id])
  user    User?         @relation(fields: [userId], references: [id])
  driver  Driver?
  invites StaffInvite[]

  @@map("employees")
}

model Driver {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String             @map("company_id") @db.Uuid
  employeeId         String             @unique @map("employee_id") @db.Uuid
  licenseNumber      String?            @map("license_number")
  licenseExpiryDate  DateTime?          @map("license_expiry_date") @db.Date
  availabilityStatus AvailabilityStatus @default(AVAILABLE) @map("availability_status")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  company          Company   @relation(fields: [companyId], references: [id])
  employee         Employee  @relation(fields: [employeeId], references: [id])
  assignedMachines Machine[] @relation("MachineAssignedDriver")
  bookings         Booking[]
  jobs             Job[]

  @@map("drivers")
}

model Village {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  name      String
  // Same rationale as Customer.isActive — a Village referenced by any
  // Booking can never be hard-deleted; this is the Manager-facing
  // alternative once it's no longer usable for new bookings.
  isActive  Boolean @default(true) @map("is_active")

  company      Company       @relation(fields: [companyId], references: [id])
  customers    Customer[]
  bookings     Booking[]
  staffInvites StaffInvite[]

  @@unique([companyId, name])
  @@map("villages")
}

// ---------- Machines (§8.3) ----------

model MachineType {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  name      String

  company  Company   @relation(fields: [companyId], references: [id])
  machines Machine[]

  @@unique([companyId, name])
  @@map("machine_types")
}

model Machine {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId            String        @map("company_id") @db.Uuid
  machineTypeId        String        @map("machine_type_id") @db.Uuid
  registrationNumber   String        @map("registration_number")
  brand                String?
  model                String?
  purchaseYear         Int?          @map("purchase_year")
  fuelType             FuelType      @default(DIESEL) @map("fuel_type")
  status               MachineStatus @default(AVAILABLE)
  hourMeterReading     Decimal       @default(0) @map("hour_meter_reading") @db.Decimal(10, 2)
  insuranceNumber      String?       @map("insurance_number")
  insuranceExpiryDate  DateTime?     @map("insurance_expiry_date") @db.Date
  assignedDriverId     String?       @map("assigned_driver_id") @db.Uuid
  nextServiceDueHours  Decimal?      @map("next_service_due_hours") @db.Decimal(10, 2)
  lastServiceDate      DateTime?     @map("last_service_date") @db.Date
  lastServiceHourMeter Decimal?      @map("last_service_hour_meter") @db.Decimal(10, 2)
  photoUrl             String?       @map("photo_url")
  isActive             Boolean       @default(true) @map("is_active")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  company        Company     @relation(fields: [companyId], references: [id])
  machineType    MachineType @relation(fields: [machineTypeId], references: [id])
  assignedDriver Driver?     @relation("MachineAssignedDriver", fields: [assignedDriverId], references: [id])

  bookings             Booking[]
  jobs                 Job[]
  jobFuelEntries       JobFuelEntry[]
  maintenanceSchedules MaintenanceSchedule[]
  maintenanceRecords   MaintenanceRecord[]
  expenses             Expense[]

  @@unique([companyId, registrationNumber])
  @@map("machines")
}

// ---------- Pricing engine (§8.2) — data-driven, new methods are inserts, not code changes ----------

model PricingMethod {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  key       String // per_hour | per_minute | per_acre | per_job | minimum_charge | custom
  label     String
  unit      String? // hour | minute | acre | null (fixed/custom)
  isActive  Boolean @default(true) @map("is_active")

  company  Company   @relation(fields: [companyId], references: [id])
  bookings Booking[]

  @@unique([companyId, key])
  @@map("pricing_methods")
}

// ---------- Bookings (§8.1) & Jobs (§8.4) — deliberately separate tables, see §7 ----------

model Booking {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String        @map("company_id") @db.Uuid
  bookingNumber   String        @map("booking_number")
  customerId      String        @map("customer_id") @db.Uuid
  villageId       String        @map("village_id") @db.Uuid
  location        String?
  machineId       String?       @map("machine_id") @db.Uuid
  driverId        String?       @map("driver_id") @db.Uuid
  managerId       String        @map("manager_id") @db.Uuid
  scheduledDate   DateTime      @map("scheduled_date") @db.Date
  scheduledTime   DateTime?     @map("scheduled_time") @db.Time
  estimatedHours  Decimal?      @map("estimated_hours") @db.Decimal(6, 2)
  estimatedAcres  Decimal?      @map("estimated_acres") @db.Decimal(8, 2)
  pricingMethodId String        @map("pricing_method_id") @db.Uuid
  rate            Decimal       @db.Decimal(10, 2)
  status          BookingStatus @default(PENDING)
  notes           String?
  createdBy       String        @map("created_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  company       Company       @relation(fields: [companyId], references: [id])
  customer      Customer      @relation(fields: [customerId], references: [id])
  village       Village       @relation(fields: [villageId], references: [id])
  machine       Machine?      @relation(fields: [machineId], references: [id])
  driver        Driver?       @relation(fields: [driverId], references: [id])
  manager       User          @relation("BookingManager", fields: [managerId], references: [id])
  creator       User          @relation("BookingCreatedBy", fields: [createdBy], references: [id])
  pricingMethod PricingMethod @relation(fields: [pricingMethodId], references: [id])

  attachments BookingAttachment[]
  job         Job?
  invoice     Invoice?

  @@unique([companyId, bookingNumber])
  @@index([companyId, status])
  @@map("bookings")
}

model BookingAttachment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  bookingId  String   @map("booking_id") @db.Uuid
  fileUrl    String   @map("file_url")
  uploadedBy String   @map("uploaded_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  company  Company @relation(fields: [companyId], references: [id])
  booking  Booking @relation(fields: [bookingId], references: [id])
  uploader User    @relation(fields: [uploadedBy], references: [id])

  @@map("booking_attachments")
}

model Job {
  id                     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId              String           @map("company_id") @db.Uuid
  bookingId              String           @unique @map("booking_id") @db.Uuid
  machineId              String           @map("machine_id") @db.Uuid
  driverId               String           @map("driver_id") @db.Uuid
  status                 JobStatus        @default(NOT_STARTED)
  executionMode          JobExecutionMode @default(LIVE) @map("execution_mode")
  startTime              DateTime?        @map("start_time")
  endTime                DateTime?        @map("end_time")
  totalPausedDurationSec Int              @default(0) @map("total_paused_duration_sec")
  actualHours            Decimal?         @map("actual_hours") @db.Decimal(6, 2)
  completedAcres         Decimal?         @map("completed_acres") @db.Decimal(8, 2)
  fuelUsedLitres         Decimal?         @map("fuel_used_litres") @db.Decimal(8, 2)
  notes                  String?
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id])
  machine Machine @relation(fields: [machineId], references: [id])
  driver  Driver  @relation(fields: [driverId], references: [id])

  statusLogs  JobStatusLog[]
  photos      JobPhoto[]
  fuelEntries JobFuelEntry[]

  @@index([companyId, status])
  @@map("jobs")
}

model JobStatusLog {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  jobId     String    @map("job_id") @db.Uuid
  status    JobStatus
  changedBy String    @map("changed_by") @db.Uuid
  changedAt DateTime  @default(now()) @map("changed_at")
  note      String?

  company       Company @relation(fields: [companyId], references: [id])
  job           Job     @relation(fields: [jobId], references: [id])
  changedByUser User    @relation(fields: [changedBy], references: [id])

  @@map("job_status_log")
}

model JobPhoto {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  jobId      String   @map("job_id") @db.Uuid
  fileUrl    String   @map("file_url")
  caption    String?
  uploadedBy String   @map("uploaded_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  company  Company @relation(fields: [companyId], references: [id])
  job      Job     @relation(fields: [jobId], references: [id])
  uploader User    @relation(fields: [uploadedBy], references: [id])

  @@map("job_photos")
}

// ---------- Fuel, Maintenance, Expenses (§4 modules) ----------

model JobFuelEntry {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  jobId      String   @map("job_id") @db.Uuid
  machineId  String   @map("machine_id") @db.Uuid
  litres     Decimal  @db.Decimal(8, 2)
  cost       Decimal? @db.Decimal(10, 2)
  recordedBy String   @map("recorded_by") @db.Uuid
  recordedAt DateTime @default(now()) @map("recorded_at")

  company  Company @relation(fields: [companyId], references: [id])
  job      Job     @relation(fields: [jobId], references: [id])
  machine  Machine @relation(fields: [machineId], references: [id])
  recorder User    @relation(fields: [recordedBy], references: [id])

  @@map("job_fuel_entries")
}

model MaintenanceSchedule {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  machineId     String   @map("machine_id") @db.Uuid
  intervalHours Decimal? @map("interval_hours") @db.Decimal(8, 2)
  intervalDays  Int?     @map("interval_days")
  description   String?
  isActive      Boolean  @default(true) @map("is_active")

  company Company             @relation(fields: [companyId], references: [id])
  machine Machine             @relation(fields: [machineId], references: [id])
  records MaintenanceRecord[]

  @@map("maintenance_schedules")
}

model MaintenanceRecord {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId             String   @map("company_id") @db.Uuid
  machineId             String   @map("machine_id") @db.Uuid
  maintenanceScheduleId String?  @map("maintenance_schedule_id") @db.Uuid
  serviceDate           DateTime @map("service_date") @db.Date
  hourMeterAtService    Decimal? @map("hour_meter_at_service") @db.Decimal(10, 2)
  description           String?
  cost                  Decimal? @db.Decimal(10, 2)
  performedBy           String?  @map("performed_by")
  createdAt             DateTime @default(now()) @map("created_at")

  company  Company              @relation(fields: [companyId], references: [id])
  machine  Machine              @relation(fields: [machineId], references: [id])
  schedule MaintenanceSchedule? @relation(fields: [maintenanceScheduleId], references: [id])

  @@map("maintenance_records")
}

model ExpenseCategory {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  name      String

  company  Company   @relation(fields: [companyId], references: [id])
  expenses Expense[]

  @@unique([companyId, name])
  @@map("expense_categories")
}

model Expense {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  categoryId      String   @map("category_id") @db.Uuid
  machineId       String?  @map("machine_id") @db.Uuid
  amount          Decimal  @db.Decimal(10, 2)
  description     String?
  incurredBy      String   @map("incurred_by") @db.Uuid
  expenseDate     DateTime @map("expense_date") @db.Date
  hsnSacCode      String?  @map("hsn_sac_code")
  isGstApplicable Boolean  @default(false) @map("is_gst_applicable")
  isItcBlocked    Boolean  @default(false) @map("is_itc_blocked")
  taxRate         Decimal? @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount       Decimal? @default(0) @map("tax_amount") @db.Decimal(10, 2)
  cessRate        Decimal? @default(0) @map("cess_rate") @db.Decimal(5, 2)
  cessAmount      Decimal? @default(0) @map("cess_amount") @db.Decimal(10, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  company        Company         @relation(fields: [companyId], references: [id])
  category       ExpenseCategory @relation(fields: [categoryId], references: [id])
  machine        Machine?        @relation(fields: [machineId], references: [id])
  incurredByUser User            @relation(fields: [incurredBy], references: [id])

  @@map("expenses")
}

// ---------- GST CESS Rules (GST-C2) ----------
model GstCessRule {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String   @map("company_id") @db.Uuid
  hsnSacCodes        String[] @map("hsn_sac_codes")
  cessRate           Decimal  @default(0) @map("cess_rate") @db.Decimal(5, 2)
  specificCessAmount Decimal? @default(0) @map("specific_cess_amount") @db.Decimal(10, 2)
  description        String?
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, isActive])
  @@map("gst_cess_rules")
}

// ---------- Payments & Invoices (§8.5) ----------
// balanceAmount is a plain stored column maintained by payments.service.ts on write,
// not a DB-generated column — consistent with the approved "no hidden logic in the
// database, business rules live in the service layer" decision.

model Invoice {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId           String        @map("company_id") @db.Uuid
  invoiceNumber       String        @map("invoice_number")
  // Nullable: manually-created invoices (not generated from a completed
  // job) have no booking to attach to. @unique still holds since Postgres
  // allows multiple NULLs in a unique column.
  bookingId           String?       @unique @map("booking_id") @db.Uuid
  customerId          String        @map("customer_id") @db.Uuid
  // Free-text reason/description, only meaningful when bookingId is null
  // (a job-generated invoice's description is the job/booking itself).
  description         String?       @map("description")
  totalAmount         Decimal       @map("total_amount") @db.Decimal(10, 2)
  paidAmount          Decimal       @default(0) @map("paid_amount") @db.Decimal(10, 2)
  balanceAmount       Decimal       @default(0) @map("balance_amount") @db.Decimal(10, 2)
  status              InvoiceStatus @default(UNPAID)
  invoiceDate         DateTime      @default(now()) @map("invoice_date") @db.Date
  dueDate             DateTime?     @map("due_date") @db.Date
  printLayoutSnapshot Json?         @map("print_layout_snapshot")
  // Phase B Invoice GST control
  isGstApplicable     Boolean       @default(false) @map("is_gst_applicable")
  hsnSacCode          String?       @map("hsn_sac_code")
  subtotalAmount      Decimal?      @map("subtotal_amount") @db.Decimal(10, 2)
  taxRate             Decimal?      @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount           Decimal?      @default(0) @map("tax_amount") @db.Decimal(10, 2)
  cgstAmount          Decimal?      @default(0) @map("cgst_amount") @db.Decimal(10, 2)
  sgstAmount          Decimal?      @default(0) @map("sgst_amount") @db.Decimal(10, 2)
  igstAmount          Decimal?      @default(0) @map("igst_amount") @db.Decimal(10, 2)
  cessRate            Decimal?      @default(0) @map("cess_rate") @db.Decimal(5, 2)
  cessAmount          Decimal?      @default(0) @map("cess_amount") @db.Decimal(10, 2)
  // Void, not delete (§ dependency-locked deletion) — an invoice stays
  // permanently visible in history/reports with status VOIDED instead of
  // being removed. voidReason is mandatory at the service layer whenever
  // status is set to VOIDED; nullable here only because every other status
  // never populates these three.
  voidReason          String?       @map("void_reason")
  voidedAt            DateTime?     @map("voided_at")
  voidedBy            String?       @map("voided_by") @db.Uuid
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  company      Company   @relation(fields: [companyId], references: [id])
  booking      Booking?  @relation(fields: [bookingId], references: [id])
  customer     Customer  @relation(fields: [customerId], references: [id])
  voidedByUser User?     @relation(fields: [voidedBy], references: [id])
  payments     Payment[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId, status])
  @@map("invoices")
}

model Payment {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String        @map("company_id") @db.Uuid
  invoiceId       String        @map("invoice_id") @db.Uuid
  amount          Decimal       @db.Decimal(10, 2)
  paymentMethod   PaymentMethod @map("payment_method")
  referenceNumber String?       @map("reference_number")
  receivedBy      String        @map("received_by") @db.Uuid
  receivedAt      DateTime      @default(now()) @map("received_at")
  notes           String?
  // Same void-not-delete pattern as Invoice — independent of the parent
  // invoice's own void state, since a single payment (not the whole
  // invoice) can be the one that was recorded in error.
  voided          Boolean       @default(false)
  voidReason      String?       @map("void_reason")
  voidedAt        DateTime?     @map("voided_at")
  voidedBy        String?       @map("voided_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")

  company      Company @relation(fields: [companyId], references: [id])
  invoice      Invoice @relation(fields: [invoiceId], references: [id])
  receiver     User    @relation("PaymentReceivedBy", fields: [receivedBy], references: [id])
  voidedByUser User?   @relation("PaymentVoidedBy", fields: [voidedBy], references: [id])

  @@index([invoiceId])
  @@index([voided])
  @@map("payments")
}

// Money received from a customer with no invoice to apply it to yet (an
// advance before a job starts, a walk-in collection). appliedAmount tracks
// how much of it has since been manually applied to invoice(s); the
// remainder (amount - appliedAmount) is the customer's live credit balance.
model CustomerAdvance {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String        @map("company_id") @db.Uuid
  customerId      String        @map("customer_id") @db.Uuid
  amount          Decimal       @db.Decimal(10, 2)
  appliedAmount   Decimal       @default(0) @map("applied_amount") @db.Decimal(10, 2)
  paymentMethod   PaymentMethod @map("payment_method")
  referenceNumber String?       @map("reference_number")
  receivedBy      String        @map("received_by") @db.Uuid
  receivedAt      DateTime      @default(now()) @map("received_at")
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at")

  company  Company  @relation(fields: [companyId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  receiver User     @relation(fields: [receivedBy], references: [id])

  @@index([customerId])
  @@map("customer_advances")
}

// ---------- Auth support (§5) ----------

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model StaffInvite {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String       @map("company_id") @db.Uuid
  roleId          String       @map("role_id") @db.Uuid
  fullName        String       @map("full_name")
  email           String?
  phone           String?
  villageId       String?      @map("village_id") @db.Uuid
  // Set when this invite grants login access to an employee record that
  // already exists (e.g. invited from the Employees page) rather than
  // creating a brand-new Employee on accept — see staffInvite.service.ts.
  employeeId      String?      @map("employee_id") @db.Uuid
  // Set when this invite grants portal access to a customer/farmer record
  // that already exists (e.g. invited from the Customers page) rather than
  // creating a brand-new Customer on accept — see staffInvite.service.ts.
  customerId      String?      @map("customer_id") @db.Uuid
  tokenHash       String       @map("token_hash")
  status          InviteStatus @default(PENDING)
  invitedByUserId String       @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime     @map("expires_at")
  acceptedAt      DateTime?    @map("accepted_at")
  createdAt       DateTime     @default(now()) @map("created_at")

  company   Company   @relation(fields: [companyId], references: [id])
  role      Role      @relation(fields: [roleId], references: [id])
  invitedBy User      @relation(fields: [invitedByUserId], references: [id])
  village   Village?  @relation(fields: [villageId], references: [id])
  employee  Employee? @relation(fields: [employeeId], references: [id])
  customer  Customer? @relation(fields: [customerId], references: [id])

  @@map("staff_invites")
}

model OtpCode {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier   String // mobile number or email
  codeHash     String     @map("code_hash")
  purpose      OtpPurpose
  expiresAt    DateTime   @map("expires_at")
  consumedAt   DateTime?  @map("consumed_at")
  attemptCount Int        @default(0) @map("attempt_count")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@map("otp_codes")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

// Single-use, short-lived handoff token for the platform-backend ->
// browser -> operational-backend launch flow: after a company is
// provisioned, the browser is redirected to
// https://<slug>.shabooagri.com/sso?token=<raw>, which exchanges it here
// for a real access/refresh token pair (see auth.service.exchangeLaunchToken).
// Owned entirely by this schema — no relation to any platform-database
// table, and nothing about it is ever readable by the platform backend
// after issuance.
model LaunchToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("launch_tokens")
}

// ---------- Audit (flagged addition, approved) ----------

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String?  @map("company_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  action     String
  changes    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  company Company? @relation(fields: [companyId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])

  @@map("audit_log")
}
