# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4000

# Postgres connection for the shabooagri_db database (isolated from Shaboo Business OS)
DATABASE_URL="postgresql://shabooagri:CHANGEME@localhost:5432/shabooagri_db"

# JWT
JWT_ACCESS_SECRET=CHANGEME
JWT_REFRESH_SECRET=CHANGEME
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# OTP delivery providers (Phase 1: Mobile/Email OTP)
OTP_SMS_PROVIDER_KEY=CHANGEME
OTP_EMAIL_PROVIDER_KEY=CHANGEME

# CORS
CORS_ORIGIN=http://localhost:5173

# Razorpay (SaaS commercial subscription checkout)
# Key ID is safe to expose to the browser; Key Secret must never leave the server.
# Webhook secret comes from Razorpay Dashboard > Settings > Webhooks after you
# register https://shabooagri.com/saas/payments/webhook there.
RAZORPAY_KEY_ID=CHANGEME
RAZORPAY_KEY_SECRET=CHANGEME
RAZORPAY_WEBHOOK_SECRET=CHANGEME
