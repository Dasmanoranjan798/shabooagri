# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4000

# Postgres connection for the shabooagri_db database (isolated from Shaboo Business OS)
DATABASE_URL="postgresql://shabooagri:CHANGEME@localhost:5432/shabooagri_db"

# JWT
JWT_ACCESS_SECRET=CHANGEME
JWT_REFRESH_SECRET=CHANGEME
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=http://localhost:5173

# Shared secret for the platform backend's internal provisioning calls
# (POST /internal/provision-company). Must match INTERNAL_API_KEY in
# platform-backend/.env exactly. Optional — if unset, that endpoint
# rejects every request with a 503 rather than the whole process
# refusing to boot.
INTERNAL_API_KEY=CHANGEME
