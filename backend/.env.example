# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4000

# Postgres connection for the shabooagri_db database (isolated from Shaboo Business OS)
DATABASE_URL="postgresql://shabooagri:CHANGEME@localhost:5432/shabooagri_db"

# JWT
JWT_ACCESS_SECRET=CHANGEME
JWT_REFRESH_SECRET=CHANGEME
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=http://localhost:5173

# Shared secret for the platform backend's internal provisioning calls
# (POST /internal/provision-company). Must match INTERNAL_API_KEY in
# platform-backend/.env exactly. Optional — if unset, that endpoint
# rejects every request with a 503 rather than the whole process
# refusing to boot.
INTERNAL_API_KEY=CHANGEME

# --- SMS gateway (Mobile + OTP login and staff-invite SMS) ---
# In production a REAL provider MUST be configured, otherwise mobile-OTP
# requests fail with a safe 503 (the "mock" provider NEVER delivers real OTPs
# and is rejected in production — it is for local dev/test only).
# Choose ONE provider and set its credentials (never commit real values):
#   SMS_PROVIDER=mock                 # dev/test only; rejected in production
#   SMS_PROVIDER=msg91                # India OTP (template-based) — recommended
#   SMS_PROVIDER=fast2sms             # India OTP (route=otp)
#   SMS_PROVIDER=twilio               # global
SMS_PROVIDER=mock
# For fast2sms / msg91:
SMS_API_KEY=
SMS_SENDER_ID=          # DLT-approved sender id (India transactional SMS)
SMS_TEMPLATE_ID=        # msg91 DLT template id
# For twilio (all three required):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
