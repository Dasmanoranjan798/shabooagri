// ShabooAgri Platform database — completely separate from the operational
// ShabooAgri database (shabooagri_db). No model here has a relation into
// the operational schema; the only connection between the two systems is
// an HTTP call (see modules/provisioning), never a shared table or join.
// This separation is deliberate: a prior version of this system had SaaS
// billing models directly related to the operational Company/User models
// in one shared schema, which is what let a license check end up gating
// every operational request. Never again.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PLATFORM_DATABASE_URL")
}

enum LicenseStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

// A registered business owner on the public/marketing side. Distinct from
// the operational User model — a PlatformUser's credentials only ever
// authenticate against the platform API, never the operational one.
model PlatformUser {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String   @unique
  passwordHash  String   @map("password_hash")
  businessName  String   @map("business_name")
  contactPerson String   @map("contact_person")
  phone         String
  address       String?
  city          String?
  state         String?
  pincode       String?
  gstin         String?
  pan           String?
  // Owner admin dashboard access (Checkpoint 3) — false for every regular
  // signup. No self-service way to become true; set directly in the DB.
  isPlatformAdmin Boolean @default(false) @map("is_platform_admin")
  // Set once /internal/provision-company succeeds. Purely informational on
  // this side — the operational company record is the source of truth for
  // everything about the provisioned tenant; this is just enough to know
  // "has this user already been provisioned, and where do they go."
  companySlug   String?  @map("company_slug")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  licenses      License[]
  payments      Payment[]

  @@map("platform_users")
}

model RefreshToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platformUserId String  @map("platform_user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  platformUser PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// Forgot-password flow for platform accounts (the admin's own login and any
// future platform-level account). Mirrors the operational OtpCode/RESET
// pattern: a hashed, single-use, time-limited token emailed as a link.
model PasswordResetToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String
  tokenHash  String    @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}

// One row per subscription period. Single-plan for now (no tiers), but
// modeled as its own table rather than fields-on-PlatformUser so renewals
// have real history instead of overwriting the same row.
model License {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platformUserId String        @map("platform_user_id") @db.Uuid
  paymentId      String?       @unique @map("payment_id") @db.Uuid
  // Which PricingPlan.key this subscription period bought — recorded on
  // the license (not just looked up live from PlatformUser/Company) so
  // history is accurate even after the plan is later renamed or its price
  // changes.
  planKey        String        @default("starter") @map("plan_key")
  startDate      DateTime?     @map("start_date")
  expiryDate     DateTime?     @map("expiry_date")
  status         LicenseStatus @default(ACTIVE)
  renewalCount   Int           @default(0) @map("renewal_count")
  
  // Dedicated secret key for device activation, distinctly separate from
  // the internal primary key id. Can be regenerated without breaking relations.
  activationKey  String        @unique @default(dbgenerated("gen_random_uuid()")) @map("activation_key") @db.Uuid
  
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  platformUser PlatformUser @relation(fields: [platformUserId], references: [id])
  payment      Payment?     @relation(fields: [paymentId], references: [id])

  @@map("licenses")
}

model Payment {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platformUserId    String        @map("platform_user_id") @db.Uuid
  planKey           String        @map("plan_key")
  // "signup" for a brand-new company, "upgrade" for an existing one
  // buying a higher tier — verifyPayment branches on this to call
  // /internal/provision-company vs /internal/update-plan.
  intent            String        @default("signup")
  gatewayOrderId    String?       @map("gateway_order_id")
  gatewayPaymentId  String?       @map("gateway_payment_id")
  gatewaySignature  String?       @map("gateway_signature")
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  gatewayPayload    Json?         @map("gateway_payload")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  platformUser PlatformUser @relation(fields: [platformUserId], references: [id])
  license      License?

  @@map("payments")
}

// Machine-count-ceiling plans (§ "plans are defined by a machine-count
// ceiling only — Drivers/Managers/Employees are never restricted").
// Owner-editable from the admin dashboard (Checkpoint 3), not hardcoded
// in application code — starting values are seeded once by seed.ts.
model PricingPlan {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key          String   @unique
  name         String
  machineLimit Int      @map("machine_limit")
  priceAnnual  Decimal  @map("price_annual") @db.Decimal(10, 2)
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("pricing_plans")
}

// Singleton row (application-enforced, not a DB constraint — the
// repository always reads/creates/updates the single oldest row). Two
// deliberately independent switches: an announcement banner can run
// without blocking purchases (a promotion), and purchasing can be
// blocked without any banner explaining why (a quiet pause) — neither
// implies the other.
model SiteSettings {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  announcementEnabled Boolean  @default(false) @map("announcement_enabled")
  announcementMessage String?  @map("announcement_message")
  purchasingBlocked   Boolean  @default(false) @map("purchasing_blocked")
  // Flat annual add-on price for a machine beyond a plan's limit, applied
  // the same regardless of which plan the company is on.
  extraMachinePrice   Decimal  @default(2000) @map("extra_machine_price") @db.Decimal(10, 2)
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

// Two of the admin dashboard's six tiles. Submission surface: public
// /contact/feedback and /contact/support endpoints, open to any visitor
// (not just logged-in platform users) — name/email identify anonymous
// submitters and are always populated (auto-filled from the account when
// the submitter is logged in, typed by hand otherwise).
model Feedback {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platformUserId String?  @map("platform_user_id") @db.Uuid
  name           String
  email          String
  message        String
  status         String   @default("NEW")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("feedback")
}

model SupportRequest {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platformUserId String?  @map("platform_user_id") @db.Uuid
  name           String
  email          String
  subject        String
  message        String
  status         String   @default("OPEN")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("support_requests")
}
