NODE_ENV=development
PORT=4010

PLATFORM_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/shabooagri_platform_db"

JWT_ACCESS_SECRET=CHANGEME
JWT_REFRESH_SECRET=CHANGEME
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

CORS_ORIGIN=https://shabooagri.com

# Shared secret for calling the operational backend's internal provisioning
# endpoint. Must match INTERNAL_API_KEY in backend/.env exactly.
INTERNAL_API_KEY=CHANGEME
OPERATIONAL_API_URL=http://localhost:4000

# Razorpay — optional. Left unset in dev/stub mode; real keys only when
# actual billing goes live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# SMTP — optional. Without it, emails (password reset, feedback/support
# notifications) are skipped with a log line instead of failing the request.
PLATFORM_APP_URL=https://shabooagri.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="ShabooAgri Support <support@example.com>"
# Mailbox that receives Feedback/Support Request notifications. Falls back
# to SMTP_USER when unset.
SUPPORT_NOTIFY_EMAIL=
